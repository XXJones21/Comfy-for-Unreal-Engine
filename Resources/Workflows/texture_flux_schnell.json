{
  "comfy_unreal": {
    "version": 1,
    "display_name": "Seamless Texture (Flux Schnell)",
    "category": "Texture",
    "description": "A flat, evenly lit surface texture from a text prompt in 4 steps. Stock ComfyUI nodes only. Needs flux1-schnell-fp8.safetensors in models/checkpoints. Pair with Create material to get a tileable PBR material.",
    "inputs": [
      {
        "name": "prompt",
        "label": "Surface",
        "node_id": "10",
        "input": "string_b",
        "type": "Text",
        "tooltip": "What the surface looks like, for example: mossy cobblestone path"
      },
      {
        "name": "seed",
        "label": "Seed",
        "node_id": "3",
        "input": "seed",
        "type": "Seed"
      },
      {
        "name": "width",
        "label": "Width",
        "node_id": "5",
        "input": "width",
        "type": "Int"
      },
      {
        "name": "height",
        "label": "Height",
        "node_id": "5",
        "input": "height",
        "type": "Int"
      },
      {
        "name": "steps",
        "label": "Steps",
        "node_id": "3",
        "input": "steps",
        "type": "Int"
      },
      {
        "name": "ckpt_name",
        "label": "Checkpoint",
        "node_id": "4",
        "input": "ckpt_name",
        "type": "Model",
        "prefer": [
          "flux1-schnell-fp8",
          "flux1-schnell"
        ],
        "family": "flux-schnell-checkpoint"
      }
    ],
    "outputs": [
      {
        "name": "albedo",
        "node_id": "9",
        "kind": "Texture",
        "slot": "BaseColor"
      }
    ]
  },
  "prompt": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "Load Checkpoint"
      },
      "inputs": {
        "ckpt_name": "flux1-schnell-fp8.safetensors"
      }
    },
    "10": {
      "class_type": "StringConcatenate",
      "_meta": {
        "title": "Texture prompt"
      },
      "inputs": {
        "string_a": "seamless tileable texture, flat top-down orthographic view, even diffuse lighting, no shadows, no perspective, highly detailed material surface:",
        "string_b": "mossy cobblestone path",
        "delimiter": " "
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive"
      },
      "inputs": {
        "text": [
          "10",
          0
        ],
        "clip": [
          "4",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative"
      },
      "inputs": {
        "text": "",
        "clip": [
          "4",
          1
        ]
      }
    },
    "5": {
      "class_type": "EmptySD3LatentImage",
      "_meta": {
        "title": "Size"
      },
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler"
      },
      "inputs": {
        "seed": 0,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "4",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      },
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "4",
          2
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "Albedo"
      },
      "inputs": {
        "filename_prefix": "unreal/texture",
        "images": [
          "8",
          0
        ]
      }
    }
  }
}
