{
  "comfy_unreal": {
    "display_name": "Seamless Texture (Flux Dev GGUF)",
    "category": "Textures",
    "description": "Higher-quality surface texture with Flux Dev in a quantized GGUF, for 12-16 GB GPUs. Needs the ComfyUI-GGUF custom nodes, a flux1-dev GGUF in models/unet, clip_l and t5xxl_fp8_e4m3fn in models/clip (or text_encoders), and the Flux VAE (ae.safetensors) in models/vae.",
    "inputs": [
      {
        "name": "prompt",
        "label": "Surface",
        "node_id": "10",
        "input": "string_b",
        "type": "Text",
        "tooltip": "What the surface looks like, for example: weathered red brick wall"
      },
      {
        "name": "seed",
        "label": "Seed",
        "node_id": "3",
        "input": "seed",
        "type": "Seed"
      },
      {
        "name": "width",
        "label": "Width",
        "node_id": "5",
        "input": "width",
        "type": "Int"
      },
      {
        "name": "height",
        "label": "Height",
        "node_id": "5",
        "input": "height",
        "type": "Int"
      },
      {
        "name": "steps",
        "label": "Steps",
        "node_id": "3",
        "input": "steps",
        "type": "Int"
      },
      {
        "name": "guidance",
        "label": "Guidance",
        "node_id": "12",
        "input": "guidance",
        "type": "Float"
      },
      {
        "name": "unet_name",
        "label": "Model (GGUF)",
        "node_id": "1",
        "input": "unet_name",
        "type": "Model",
        "prefer": [
          "flux1-dev-Q4_K_S",
          "flux1-dev"
        ],
        "family": "flux-dev-gguf"
      },
      {
        "name": "clip_l",
        "label": "CLIP-L",
        "node_id": "2",
        "input": "clip_name1",
        "type": "Model",
        "prefer": [
          "clip_l"
        ],
        "family": "clip-l"
      },
      {
        "name": "t5",
        "label": "T5-XXL",
        "node_id": "2",
        "input": "clip_name2",
        "type": "Model",
        "prefer": [
          "t5xxl_fp8_e4m3fn",
          "t5xxl"
        ],
        "family": "t5-xxl"
      },
      {
        "name": "vae_name",
        "label": "VAE",
        "node_id": "13",
        "input": "vae_name",
        "type": "Model",
        "prefer": [
          "flux_vae",
          "ae.safetensors"
        ],
        "family": "flux-vae",
        "tooltip": "The 16-channel Flux VAE. Some installs name it ae.safetensors, some flux_vae.safetensors."
      }
    ],
    "outputs": [
      {
        "name": "albedo",
        "node_id": "9",
        "kind": "Image",
        "import": "Texture"
      }
    ]
  },
  "prompt": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "_meta": {
        "title": "Unet Loader (GGUF)"
      },
      "inputs": {
        "unet_name": "flux1-dev-Q4_K_S.gguf"
      }
    },
    "2": {
      "class_type": "DualCLIPLoader",
      "_meta": {
        "title": "Text encoders"
      },
      "inputs": {
        "clip_name1": "clip_l.safetensors",
        "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
        "type": "flux"
      }
    },
    "13": {
      "class_type": "VAELoader",
      "_meta": {
        "title": "VAE"
      },
      "inputs": {
        "vae_name": "ae.safetensors"
      }
    },
    "10": {
      "class_type": "StringConcatenate",
      "_meta": {
        "title": "Texture prompt"
      },
      "inputs": {
        "string_a": "seamless tileable texture, flat top-down orthographic view, even diffuse lighting, no shadows, no perspective, highly detailed material surface:",
        "string_b": "weathered red brick wall",
        "delimiter": " "
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive"
      },
      "inputs": {
        "text": [
          "10",
          0
        ],
        "clip": [
          "2",
          0
        ]
      }
    },
    "12": {
      "class_type": "FluxGuidance",
      "_meta": {
        "title": "Guidance"
      },
      "inputs": {
        "guidance": 3.5,
        "conditioning": [
          "6",
          0
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative"
      },
      "inputs": {
        "text": "",
        "clip": [
          "2",
          0
        ]
      }
    },
    "5": {
      "class_type": "EmptySD3LatentImage",
      "_meta": {
        "title": "Size"
      },
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler"
      },
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "12",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      },
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "13",
          0
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "Albedo"
      },
      "inputs": {
        "filename_prefix": "unreal/texture",
        "images": [
          "8",
          0
        ]
      }
    }
  }
}
